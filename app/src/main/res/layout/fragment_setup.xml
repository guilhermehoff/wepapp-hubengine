<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="32dp"
        android:paddingVertical="48dp">

        <!-- Card central -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_setup_card"
            android:padding="24dp"
            android:elevation="4dp">

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="4dp" />

            <!-- Subtítulo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_subtitle"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="28dp" />

            <!-- Label do campo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="URL do sistema"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#444444"
                android:layout_marginBottom="6dp" />

            <!-- Campo de URL -->
            <EditText
                android:id="@+id/et_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/setup_url_hint"
                android:inputType="textUri"
                android:imeOptions="actionDone"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textSize="15sp"
                android:textColor="#1A1A1A"
                android:textColorHint="#AAAAAA"
                android:singleLine="true"
                android:layout_marginBottom="20dp" />

            <!-- Botão confirmar -->
            <Button
                android:id="@+id/btn_confirm"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/setup_confirm"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_confirm"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
